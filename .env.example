# ─── NikahPath environment ────────────────────────────────────────────────────
# Local development needs NONE of these: without DATABASE_URL the API uses an
# embedded PGlite database in ./.data/pglite and migrates it automatically.
# In production (Vercel → Settings → Environment Variables) set the REQUIRED ones.

# REQUIRED in production. Neon connection string (any postgres:// URL works).
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# REQUIRED in production. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=""

# REQUIRED for the daily inactivity cleaner. Vercel Cron sends it as a Bearer token.
CRON_SECRET=""

# Optional. A Google account with this verified email becomes ADMIN on first sign-in.
# Password accounts are never auto-promoted — use `npm run make-admin -- <email>`.
ADMIN_EMAIL=""

# Optional. A username/password administrator created automatically the first time
# someone signs in with ADMIN_USERNAME. Keep ADMIN_PASSWORD only in your deployment
# environment — never commit it. To change it later: `npm run create-admin -- <username>`.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Optional. Defaults to the project in firebase-applet-config.json.
FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""

# Optional. Local API port (Vite proxies /api to it).
API_PORT=3001
